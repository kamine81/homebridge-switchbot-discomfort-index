{
  "pluginAlias": "SwitchBotDiscomfortIndex",
  "pluginType": "platform",
  "singular": false,
  "headerDisplay": "Fetches temperature and humidity from SwitchBot devices via the OpenAPI v1.1, calculates the Discomfort Index, and exposes it to HomeKit. Get your token and secret from the SwitchBot app: Profile → Settings → tap App Version 10 times → Developer Options.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "required": true,
        "default": "SwitchBot Discomfort Index"
      },
      "token": {
        "title": "SwitchBot OpenAPI Token",
        "type": "string",
        "required": true
      },
      "secret": {
        "title": "SwitchBot OpenAPI Secret",
        "type": "string",
        "required": true
      },
      "sensors": {
        "title": "Sensors",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Display Name",
              "type": "string",
              "required": true,
              "default": "Discomfort Index"
            },
            "deviceId": {
              "title": "Device ID",
              "type": "string",
              "required": true,
              "pattern": "^[A-Fa-f0-9]{12}$",
              "description": "12-digit hex deviceId from GET /v1.1/devices"
            },
            "updateInterval": {
              "title": "Update Interval (seconds)",
              "type": "integer",
              "default": 60,
              "minimum": 30,
              "maximum": 3600,
              "description": "How often to poll the SwitchBot API (30–3600 seconds, default 60)"
            },
            "enableScale": {
              "title": "Enable scale conversion",
              "type": "boolean",
              "default": false,
              "description": "Multiply the DI before exposing it to HomeKit so automation thresholds (which step in increments of 5) can target a finer DI granularity. When off, the raw DI is used."
            },
            "scale": {
              "title": "Scale factor",
              "type": "number",
              "default": 2,
              "minimum": 1,
              "maximum": 10,
              "description": "Factor multiplied with the DI (e.g. 2 makes one HomeKit 5-step equal 2.5 DI). The Home app will display DI × scale."
            }
          }
        }
      }
    }
  },
  "form": [
    "name",
    "token",
    "secret",
    {
      "key": "sensors",
      "items": [
        "sensors[].name",
        "sensors[].deviceId",
        {
          "key": "sensors[].updateInterval",
          "type": "number"
        },
        "sensors[].enableScale",
        {
          "key": "sensors[].scale",
          "type": "number",
          "condition": {
            "functionBody": "return model.sensors && model.sensors[arrayIndices] && model.sensors[arrayIndices].enableScale === true;"
          }
        }
      ]
    }
  ]
}
