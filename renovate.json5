{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  // 毎週月曜 JST 9時前に更新チェック
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "packageRules": [
    // typescript-eslint は常にセットで更新
    {
      "matchPackageNames": [
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
      ],
      "groupName": "typescript-eslint",
    },
    // vitest 本体とカバレッジプラグインをまとめて更新
    {
      "matchPackageNames": [
        "vitest",
        "@vitest/coverage-v8",
      ],
      "groupName": "vitest",
    },
    // ESLint 関連をまとめて更新
    {
      "matchPackageNames": [
        "eslint",
        "eslint-config-prettier",
        "@eslint/js",
      ],
      "groupName": "eslint",
    },
  ],
}
