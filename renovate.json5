{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  // 毎週月曜 JST 9時前に更新チェック
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "packageRules": [
    // Lint / format 関連をまとめて更新
    {
      "matchPackageNames": [
        "eslint",
        "@eslint/js",
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "eslint-config-prettier",
        "globals",
        "prettier",
      ],
      "groupName": "lint/format",
    },
    // テスト関連をまとめて更新
    {
      "matchPackageNames": [
        "vitest",
        "@vitest/coverage-v8",
      ],
      "groupName": "test",
    },
    // TypeScript / 型定義をまとめて更新
    {
      "matchPackageNames": [
        "typescript",
        "@types/node",
      ],
      "groupName": "typescript",
    },
    // Homebridge 関連をまとめて更新
    {
      "matchPackageNames": [
        "homebridge",
        "@homebridge/hap-nodejs",
      ],
      "groupName": "homebridge",
    },
    // ビルド補助ツールをまとめて更新
    {
      "matchPackageNames": [
        "rimraf",
        "nodemon",
      ],
      "groupName": "build-tools",
    },
    // GitHub Actions をまとめて更新
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
    },
  ],
}
